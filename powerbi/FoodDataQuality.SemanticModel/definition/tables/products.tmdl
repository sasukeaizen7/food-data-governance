table products
	lineageTag: 340e3234-1933-577f-a6a5-ab69691e08c3

	measure Products = COUNTROWS(products)
		formatString: #,0
		lineageTag: 41e75230-85dd-513d-b175-fd317b0a2616

	measure 'Trusted products' = CALCULATE([Products], products[trust_level] = "trusted")
		formatString: #,0
		lineageTag: 8830a60b-9a6d-55c5-a612-471a2c836d62

	measure 'Caution products' = CALCULATE([Products], products[trust_level] = "caution")
		formatString: #,0
		lineageTag: 216526a0-5294-5bd3-843d-d3c8b9fe0bee

	measure 'Untrusted products' = CALCULATE([Products], products[trust_level] = "untrusted")
		formatString: #,0
		lineageTag: 0f897dc6-a318-5269-b9fa-e62af0d3a814

	measure 'Trusted %' = DIVIDE([Trusted products], [Products])
		formatString: 0.0%
		lineageTag: 8fb3655a-5814-50a1-831b-e28722b1f585

	measure 'Untrusted %' = DIVIDE([Untrusted products], [Products])
		formatString: 0.0%
		lineageTag: bb113d18-e140-523d-9756-5b738c1591ba

	measure Scans = SUM(products[unique_scans])
		formatString: #,0
		lineageTag: 5c60287f-b64b-5d79-a435-29de69e2e229

	measure 'Scans on trusted %' = DIVIDE(CALCULATE([Scans], products[trust_level] = "trusted"), [Scans])
		formatString: 0.0%
		lineageTag: 42ebfab6-c1e3-5fdc-a1d6-46a9083c7104

	measure 'Avg sugars (trusted)' = CALCULATE(AVERAGE(products[sugars_100g]), products[trust_level] = "trusted")
		formatString: 0.0
		lineageTag: 76696286-2139-5f3f-b232-5af927ce4a4a

	measure 'Avg sugars (all)' = AVERAGE(products[sugars_100g])
		formatString: 0.0
		lineageTag: fb6e3f34-c26a-57eb-8807-7621f350bff0

	measure 'Avg sugars (trusted, A-E)' = CALCULATE([Avg sugars (trusted)], KEEPFILTERS(products[nutriscore_grade] IN {"a", "b", "c", "d", "e"}))
		formatString: 0.0
		lineageTag: 80db0631-e20c-546e-837f-01e5374b41af

	measure 'Impossible sugar records' = CALCULATE([Products], products[sugars_100g] > 100)
		formatString: #,0
		lineageTag: 7d388315-0618-569a-b88c-2b4e24112a2d

	measure 'Highest declared sugars' = MAX(products[sugars_100g])
		formatString: 0.00E+00
		lineageTag: 3c04bb1d-827d-521c-bee2-63e60d4c9106

